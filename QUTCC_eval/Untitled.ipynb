   "source": [
    "import lzma\n",
    "\n",
    "input_pth_file = './qutcc.pth'\n",
    "compressed_xz_file = 'qutcc.pth.xz'\n",
    "\n",
    "with open(input_pth_file, 'rb') as f_in:\n",
    "    with lzma.open(compressed_xz_file, 'wb') as f_out:\n",
    "        f_out.write(f_in.read())"
   ]
  }
